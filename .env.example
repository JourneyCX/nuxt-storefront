# Copy to .env

# Internal URL for Stratum API (never exposed to browser)
STRATUM_INTERNAL_URL=http://localhost:8080

# Port for the Nuxt dev server
PORT=3000

# Phase 2 — optional, for local development overrides
# WooCommerce credentials are fetched dynamically per-tenant from Stratum.
# No WC credentials are stored here; they live in tbl_sb_tenant_woocommerce.

# Nuxt cache invalidation secret (set the same value in Stratum settings)
# NUXT_INVALIDATE_SECRET=changeme

# Supplier Network checkout-time stock reservation API (Laravel) — see
# server/utils/supplierNetwork.ts. Must match config/services.php's
# supplier_network_checkout.shared_secret on the Laravel side.
SUPPLIER_NETWORK_CHECKOUT_URL=https://laravel.stratumengage.com
SUPPLIER_NETWORK_CHECKOUT_SECRET=changeme
